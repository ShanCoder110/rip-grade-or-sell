# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to 1 to allow demo sign-in when running `next start` (Playwright CI). Off in real production.
RGS_DEMO_AUTH=
# Playwright CI only: omit a slug from generateStaticParams to assert on-demand ISR (see e2e/smoke.spec.ts)
E2E_OMIT_STATIC_SET_SLUG=

# Supabase — leave empty for demo mode (seed data + demo sign-in on /auth/login).
# After `supabase start`, paste the URL and keys from the CLI output into .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron (protect /api/cron/* routes)
CRON_SECRET=dev-cron-secret-change-me

# Email (optional — alerts degrade gracefully without)
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@example.com

# Google AdSense (optional — no ads shown until client id + slot ids are set and user accepts cookies)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_SET=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
# Numeric or pub- prefixed id for /ads.txt (server-only)
ADSENSE_PUBLISHER_ID=

# Observability (optional)
SENTRY_DSN=

# External APIs (optional — ingestion uses seed/sample data locally)
POKEMONTCG_API_KEY=
