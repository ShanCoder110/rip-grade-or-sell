# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: supabase start — see README)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron (protect /api/cron/* routes)
CRON_SECRET=dev-cron-secret-change-me

# Email (optional — alerts degrade gracefully without)
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@example.com

# Billing
# With STRIPE_SECRET_KEY + price IDs, checkout uses Stripe test mode.
# Without them, local dev uses a labeled demo checkout that unlocks Pro in the browser.
# Set DEMO_CHECKOUT=false to disable that fallback. DEMO_CHECKOUT=true forces it (including production).
BILLING_PROVIDER=stripe
BILLING_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
DEMO_CHECKOUT=

# Observability (optional)
SENTRY_DSN=

# External APIs (optional — ingestion uses seed/sample data locally)
POKEMONTCG_API_KEY=
